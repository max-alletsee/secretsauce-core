{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@secretsauce/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*", "packages/*/src/**/*", "tests/**/*"]
}
