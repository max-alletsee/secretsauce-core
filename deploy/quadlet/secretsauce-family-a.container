[Unit]
Description=SecretSauce for Family A
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Container]
Image=localhost/secretsauce:current
ContainerName=secretsauce-family-a
Pull=never
PublishPort=127.0.0.1:8081:8080
Volume=/var/lib/secretsauce/family-a:/data:Z
Environment=COOKIE_SECURE=true
# Default rootful Podman bridge gateway; verify with `podman network inspect podman` on this host.
Environment=FORWARDED_ALLOW_IPS=10.88.0.1
HealthOnFailure=kill
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=45s
HealthRetries=3

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=35s

[Install]
WantedBy=multi-user.target
